# ═══════════════════════════════════════════════════════════════════════════════
# Aegis Enterprise - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and update the values for your environment
# 
# cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application Settings ──────────────────────────────────────────────────────
NODE_ENV=production
MODE=demo
PORT=3000
FRONTEND_PORT=5173

# ─── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# ─── Database Configuration ────────────────────────────────────────────────────
# PostgreSQL (Production)
POSTGRES_DB=aegis_enterprise
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (auto-generated, but can be overridden)
DATABASE_URL=postgresql://aegis:CHANGE_THIS_SECURE_PASSWORD_123!@localhost:5432/aegis_enterprise?schema=public

# Test database
TEST_DATABASE_URL=postgresql://aegis:CHANGE_THIS_SECURE_PASSWORD_123!@localhost:5432/aegis_test?schema=public

# ─── Redis Configuration ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Security & Authentication ─────────────────────────────────────────────────
# Generate a strong secret key: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET_KEY_MIN_32_CHARS_LONG!
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption key for sensitive data (32 characters)
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_32_CHARS!

# Session secret
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_MIN_32_CHARS!

# ─── AI Services ───────────────────────────────────────────────────────────────
# Google Gemini API (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini model configuration
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ─── Email Configuration (SendGrid) ────────────────────────────────────────────
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE
SENDGRID_FROM_EMAIL=noreply@your-domain.com
SENDGRID_FROM_NAME=Aegis Security

# ─── External Threat Intelligence (Optional) ───────────────────────────────────
# VirusTotal API (get from https://www.virustotal.com)
VIRUSTOTAL_API_KEY=

# AbuseIPDB API (get from https://www.abuseipdb.com)
ABUSEIPDB_API_KEY=

# ─── Vector Database (Qdrant) ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Discord Alerts (Optional) ─────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=

# ─── Monitoring & Observability ────────────────────────────────────────────────
# Enable detailed logging
LOG_LEVEL=info
LOG_FORMAT=json

# Health check settings
HEALTH_CHECK_INTERVAL=30000

# ─── Performance Tuning ────────────────────────────────────────────────────────
# Event processing
EVENT_BATCH_SIZE=100
EVENT_PROCESSING_INTERVAL=1000

# Detection settings
WINDOW_SIZE=60
ZSCORE_THRESHOLD=3.0
EWMA_ALPHA=0.15
IFOREST_ENABLED=true
HYBRID_FUSION=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ─── Docker Configuration ──────────────────────────────────────────────────────
# These are used by docker-compose
DOCKER_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
DOCKER_REDIS_URL=redis://redis:6379
DOCKER_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ─── SSL/TLS Configuration ─────────────────────────────────────────────────────
# Paths to SSL certificates (for production)
SSL_CERT_PATH=/etc/nginx/ssl/certificate.crt
SSL_KEY_PATH=/etc/nginx/ssl/private.key

# ─── Backup Configuration ──────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/storage/backups

# ─── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_WEBSOCKETS=true
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_AUTO_INCIDENT_CREATION=true
ENABLE_AI_DIAGNOSIS=true
ENABLE_DISCORD_ALERTS=false
ENABLE_EMAIL_ALERTS=false

# ─── Demo Mode Settings ────────────────────────────────────────────────────────
DEMO_MODE=true
DEMO_AUTO_REPLAY=true
DEMO_REPLAY_SPEED=1

# ─── Organization Settings (Multi-tenant) ──────────────────────────────────────
DEFAULT_ORG_NAME=Default Organization
DEFAULT_ORG_SLUG=default
MAX_ORGS_PER_USER=5

# ─── User Settings ─────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false

# ─── File Upload Settings ──────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=/app/storage/uploads
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv,json

# ─── CORS Configuration ────────────────────────────────────────────────────────
CORS_ORIGIN=*
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# ═══════════════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════